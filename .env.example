# Application identity shown in the footer for developer/version identification
APP_NAME="Telco Revenue-Aware Power Outage Prioritizer"
APP_VERSION="R1.1"
APP_PATCH="P01-SUPABASE"
APP_BUILD="2026-05-01"
APP_DEPLOYMENT_TARGET="AWS EC2 + Apache + Supabase PostgreSQL"

# Change this before deployment
APP_SECRET_KEY="change-this-secret-key"

# Recommended deployment database: Supabase PostgreSQL
# Replace PROJECT_REF, PASSWORD, REGION using Supabase Dashboard > Connect.
# Keep sslmode=require. URL-encode special characters in the password.
DATABASE_URL="postgresql+psycopg2://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Local/offline fallback for testing only:
# DATABASE_URL="sqlite:///./data/telco_priority.db"

UPLOAD_DIR="./data/uploads"
MODEL_DIR="./data/models"

OLLAMA_URL="http://127.0.0.1:11434/api/generate"
OLLAMA_MODEL="llama3.2:1b"
ENABLE_OLLAMA="false"

DATA_CHARGE_PER_MB="0.30"
VOICE_CHARGE_PER_MIN="1.50"
